# Copy to Scripts/web.env (git-ignored) and fill in. Read by deploy-web.sh and release.sh.
# Any value can also be passed as an environment variable instead.

# ---- deploy-web.sh: where the website lives
# ftp://, ftps:// (implicit TLS) or sftp:// (sftp needs lftp: brew install lftp).
# Plain ftp:// still upgrades to TLS when the server supports it.
FTP_URL="ftp://ftp.example.com"
FTP_USER=""
FTP_PASSWORD=""
# The site's web root, relative to the folder the FTP account logs into ("" if it's that folder).
FTP_REMOTE_DIR="public_html"
# Set to 1 if the host's TLS certificate doesn't match its FTP hostname.
FTP_INSECURE=0
# Optional: a production config uploaded as includes/config.local.php.
# DEPLOY_CONFIG_FILE="Scripts/config.production.php"

# ---- release.sh: the live site and an API token from Admin → Account → API Tokens
BEATSNAP_SITE_URL="https://beatsnap.example.com"
BEATSNAP_API_TOKEN=""

# ---- Sparkle updates: public key, written by Scripts/sparkle-setup.sh
BEATSNAP_SPARKLE_PUBLIC_KEY=""
